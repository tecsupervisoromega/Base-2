# =============================================================================
# Base-2 DDD — variables de entorno (ejemplo)
# Copiar a .env y ajustar
# =============================================================================

# ---- Postgres + PostGIS --------------------------------------------------
POSTGRES_USER=base2
POSTGRES_PASSWORD=base2_dev
POSTGRES_DB=base2_ddd
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# URL completa para Prisma
DATABASE_URL=postgresql://base2:base2_dev@localhost:5432/base2_ddd?schema=public

# ---- MinIO (S3 local) ----------------------------------------------------
MINIO_ROOT_USER=base2
MINIO_ROOT_PASSWORD=base2_dev_minio
MINIO_ENDPOINT=http://localhost:9000
MINIO_BUCKET=base2

# ---- Backend (NestJS) ----------------------------------------------------
BACKEND_PORT=4000
JWT_SECRET=cambiar-en-produccion-super-secreto
JWT_EXPIRES_IN=7d

# ---- Frontend web (Next.js gestion) --------------------------------------
WEB_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:4000

# ---- PWA tecnico (Next.js) -----------------------------------------------
MOBILE_PORT=3100
NEXT_PUBLIC_MOBILE_API_URL=http://localhost:4000
